{
  "compileOnSave": false,
  "compilerOptions": {
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "skipLibCheck": true,
    "strict": true,
    "paths": {
      "@soportedesk/core": [
        "./libs/core/src/index.ts"
      ],
      "@soportedesk/ui": [
        "./libs/ui/src/index.ts"
      ]
    }
  }
}
