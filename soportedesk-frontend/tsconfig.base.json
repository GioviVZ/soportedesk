{
  "compileOnSave": false,
  "compilerOptions": {
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "skipLibCheck": true,
    "strict": true,
    "paths": {
      "@soportedesk/core": [
        "./libs/core/src/index.ts"
      ],
      "@soportedesk/ui": [
        "./libs/ui/src/index.ts"
      ],
      "@soportedesk/auditoria": [
        "./libs/auditoria/src/index.ts"
      ],
      "@soportedesk/auth": [
        "./libs/auth/src/index.ts"
      ],
      "@soportedesk/wifi": [
        "./libs/wifi/src/index.ts"
      ],
      "@soportedesk/usuarios-sistema": [
        "./libs/usuarios-sistema/src/index.ts"
      ],
      "@soportedesk/correos": [
        "./libs/correos/src/index.ts"
      ],
      "@soportedesk/licencias": [
        "./libs/licencias/src/index.ts"
      ],
      "@soportedesk/impresoras": [
        "./libs/impresoras/src/index.ts"
      ]
    }
  }
}
