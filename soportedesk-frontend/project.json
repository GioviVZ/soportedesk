{
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "name": "soportedesk-frontend",
  "projectType": "application",
  "generators": {
    "@schematics/angular:component": {
      "style": "scss"
    }
  },
  "sourceRoot": "src",
  "prefix": "app",
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "options": {
        "outputPath": "dist/soportedesk-frontend",
        "index": "src/index.html",
        "browser": "src/main.ts",
        "polyfills": [
          "zone.js"
        ],
        "tsConfig": "tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "stylePreprocessorOptions": {
          "sass": {
            "silenceDeprecations": [
              "import",
              "global-builtin",
              "color-functions",
              "if-function"
            ]
          }
        },
        "assets": [
          "src/favicon.ico",
          "src/assets"
        ],
        "styles": [
          "node_modules/@tabler/icons-webfont/dist/tabler-icons.css",
          "src/styles.scss"
        ],
        "allowedCommonJsDependencies": [
          "qrcode",
          "xlsx"
        ],
        "scripts": []
      },
      "configurations": {
        "production": {
          "optimization": {
            "scripts": true,
            "styles": {
              "minify": true,
              "inlineCritical": false
            },
            "fonts": true
          },
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "1.01mb",
              "maximumError": "1.2mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "20kb",
              "maximumError": "22kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production",
      "outputs": [
        "{options.outputPath}"
      ]
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "options": {
        "proxyConfig": "proxy.conf.json"
      },
      "configurations": {
        "production": {
          "buildTarget": "soportedesk-frontend:build:production"
        },
        "development": {
          "buildTarget": "soportedesk-frontend:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "soportedesk-frontend:build"
      }
    },
    "test": {
      "executor": "@angular/build:karma",
      "options": {
        "polyfills": [
          "zone.js",
          "zone.js/testing"
        ],
        "tsConfig": "tsconfig.spec.json",
        "include": [
          "**/*.spec.ts",
          "../libs/**/*.spec.ts"
        ],
        "browsers": "ChromeHeadlessNoSandbox",
        "watch": false,
        "inlineStyleLanguage": "scss",
        "stylePreprocessorOptions": {
          "sass": {
            "silenceDeprecations": [
              "import",
              "global-builtin",
              "color-functions",
              "if-function"
            ]
          }
        },
        "assets": [
          "src/favicon.ico",
          "src/assets"
        ],
        "styles": [
          "node_modules/@tabler/icons-webfont/dist/tabler-icons.css",
          "src/styles.scss"
        ],
        "scripts": []
      }
    }
  }
}
